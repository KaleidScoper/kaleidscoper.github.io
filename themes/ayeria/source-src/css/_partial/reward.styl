// Reward / donation modal
// Follows the same CSS custom-property pattern as share.styl.
// Active state uses elevation (raised card on a recessed track), not color.

// ─── Light mode ───────────────────────────────────────────────────────────────
\:root
  --reward-bg               rgba(252, 250, 247, 0.97)
  --reward-border           rgba(0, 0, 0, 0.07)
  --reward-shadow           0 6px 24px rgba(0, 0, 0, 0.09)
  --reward-text             #333333
  --reward-subtext          #777777
  --reward-overlay          rgba(0, 0, 0, 0.45)

  --reward-tabs-track       rgba(0, 0, 0, 0.06)
  --reward-tab-text         #666666
  --reward-tab-hover        rgba(0, 0, 0, 0.05)
  --reward-tab-active-bg    #ffffff
  --reward-tab-active-text  #333333
  --reward-tab-active-shadow 0 1px 4px rgba(0, 0, 0, 0.13)

  --reward-badge-bg         rgba(0, 0, 0, 0.08)

  --reward-btn-bg           rgba(255, 255, 255, 0.55)
  --reward-btn-border       rgba(0, 0, 0, 0.11)
  --reward-btn-text         #555555
  --reward-btn-icon         #888888
  --reward-btn-shadow       0 2px 10px rgba(0, 0, 0, 0.07)
  --reward-btn-hover-bg     rgba(255, 255, 255, 0.80)

// ─── Dark mode ────────────────────────────────────────────────────────────────
body.darkmode
  --reward-bg               rgba(42, 47, 58, 0.97)
  --reward-border           rgba(255, 255, 255, 0.09)
  --reward-shadow           0 6px 24px rgba(0, 0, 0, 0.45)
  --reward-text             dark-text
  --reward-subtext          dark-text-secondary
  --reward-overlay          rgba(0, 0, 0, 0.65)

  --reward-tabs-track       rgba(0, 0, 0, 0.28)
  --reward-tab-text         #999999
  --reward-tab-hover        rgba(255, 255, 255, 0.06)
  --reward-tab-active-bg    rgba(255, 255, 255, 0.13)
  --reward-tab-active-text  dark-text
  --reward-tab-active-shadow 0 1px 4px rgba(0, 0, 0, 0.45)

  --reward-badge-bg         rgba(255, 255, 255, 0.12)

  --reward-btn-bg           rgba(255, 255, 255, 0.08)
  --reward-btn-border       rgba(255, 255, 255, 0.13)
  --reward-btn-text         dark-tag-text
  --reward-btn-icon         #999999
  --reward-btn-shadow       0 2px 10px rgba(0, 0, 0, 0.28)
  --reward-btn-hover-bg     rgba(255, 255, 255, 0.14)

// ─── Overlay ──────────────────────────────────────────────────────────────────
#mask
  position fixed
  top 0
  left 0
  right 0
  bottom 0
  z-index 9998
  background var(--reward-overlay)
  visibility hidden
  opacity 0
  pointer-events none
  transition opacity 0.25s ease, visibility 0.25s ease

  &.active
    visibility visible
    opacity 1
    pointer-events auto

// ─── Modal panel ──────────────────────────────────────────────────────────────
.reward-modal
  position fixed
  z-index 9999
  left 50%
  top 50%
  transform translate(-50%, -50%) scale(0.96)
  width 380px
  max-width 92vw
  max-height 88vh
  overflow-y auto
  padding 24px 24px 28px
  background var(--reward-bg)
  -webkit-backdrop-filter blur(16px)
  backdrop-filter blur(16px)
  border 1px solid var(--reward-border)
  border-radius 12px
  box-shadow var(--reward-shadow)
  font-family font-family-sans
  text-align center
  visibility hidden
  pointer-events none
  opacity 0
  transition opacity 0.25s ease, transform 0.25s ease, visibility 0.25s ease

  &.visible
    visibility visible
    pointer-events auto
    opacity 1
    transform translate(-50%, -50%) scale(1)

// ─── Close button ─────────────────────────────────────────────────────────────
.reward-close
  position absolute
  right 10px
  top 10px
  width 30px
  height 30px
  display flex
  align-items center
  justify-content center
  padding 0
  border 0
  background transparent
  border-radius 50%
  cursor pointer
  transition background 0.2s ease
  color var(--reward-subtext)

  &:hover
    background var(--reward-tab-hover)

  i
    font-size 18px
    color var(--reward-subtext)

// ─── Heading ──────────────────────────────────────────────────────────────────
.reward-wording
  text-align center
  font-size 14px
  color var(--reward-subtext)
  margin 4px 16px 20px
  overflow-wrap anywhere
  line-height 1.5

  i
    margin-right 5px
    color var(--reward-subtext)

// ─── Channel tabs — segmented control ─────────────────────────────────────────
// The track is a recessed container; the active item floats up with a white
// background and shadow. No color is used to communicate selection.
.reward-tabs,
.reward-sub-tabs
  display flex
  width max-content
  max-width 100%
  gap 3px
  margin 0 auto
  overflow-x auto
  background var(--reward-tabs-track)
  border-radius 8px
  padding 3px

.reward-tabs
  margin-bottom 20px

.reward-tab,
.reward-sub-tab
  display inline-flex
  flex-shrink 0
  align-items center
  gap 5px
  padding 6px 14px
  border none
  border-radius 6px
  background transparent
  color var(--reward-tab-text)
  font-size 13px
  cursor pointer
  transition background 0.2s ease, color 0.15s ease, box-shadow 0.2s ease
  white-space nowrap
  font-family inherit
  line-height 1.4

  &:hover:not(.active)
    background var(--reward-tab-hover)

  &.active
    background var(--reward-tab-active-bg)
    color var(--reward-tab-active-text)
    font-weight 500
    box-shadow var(--reward-tab-active-shadow)

  i
    font-size 15px
    color inherit

// Inactive panels keep their grid area so channel/network switches never resize
// the modal. Their content remains hidden and inert (see modal.ejs / ayeria.js).
.reward-panels,
.reward-method-panels
  display grid
  min-width 0

.reward-panel,
.reward-sub-panel
  grid-area 1 / 1
  min-width 0
  align-self start
  visibility hidden
  opacity 0
  pointer-events none
  text-align center
  transition opacity 0.2s ease

  &.active
    visibility inherit
    opacity 1
    pointer-events auto

// A single-method channel uses the available body space symmetrically instead
// of leaving all the multi-network controls' reserved space below its QR code.
.reward-panel
  align-self center

// Round the image itself; no independent white frame can escape image dimming.
.reward-qrcode-wrap
  display inline-block
  line-height 0

.reward-qrcode
  display block
  width 180px
  height 180px
  border-radius 8px
  object-fit contain

.reward-desc
  margin 10px 0 0
  font-size 13px
  color var(--reward-subtext)
  overflow-wrap anywhere

// Link to payment platform — elevated to match active tab style
.reward-link
  display inline-flex
  align-items center
  gap 4px
  margin-top 12px
  padding 7px 18px
  background var(--reward-tab-active-bg)
  color var(--reward-tab-active-text)
  box-shadow var(--reward-tab-active-shadow)
  border 1px solid var(--reward-border)
  border-radius 6px
  font-size 13px
  font-weight 500
  text-decoration none
  transition opacity 0.2s ease

  &:hover
    opacity 0.8
    text-decoration none
    color var(--reward-tab-active-text)

// ─── Trigger button ───────────────────────────────────────────────────────────
#reward-out
  position relative
  width 100%
  text-align center

.reward-trigger,
#reward-btn
  display inline-flex
  align-items center
  gap 6px
  height 38px
  padding 0 22px
  margin 40px 0
  font-size 14px
  color var(--reward-btn-text)
  background var(--reward-btn-bg)
  -webkit-backdrop-filter blur(10px)
  backdrop-filter blur(10px)
  border 1px solid var(--reward-btn-border)
  border-radius 19px
  cursor pointer
  box-shadow var(--reward-btn-shadow)
  transition all 0.25s ease
  font-family inherit
  line-height 1

  i
    color var(--reward-btn-icon)

  &:hover
    background var(--reward-btn-hover-bg)
    transform translateY(-1px)
    box-shadow 0 4px 16px rgba(0, 0, 0, 0.09)

// ─── Networks — same control style, below the common QR / description area ───
.reward-networks
  margin-top 16px

.reward-chain-hint
  text-align center
  font-size 13px
  color var(--reward-subtext)
  margin 0 0 10px
  overflow-wrap anywhere

.reward-sub-tab
  padding 6px 12px
  font-size 12px

.reward-sub-badge
  font-size 10px
  padding 1px 5px
  border-radius 4px
  background var(--reward-badge-bg)
  color var(--reward-tab-text)
  line-height 1.3

.reward-trigger:focus-visible,
#reward-btn:focus-visible,
.reward-modal :focus-visible
  outline 2px solid var(--color-link)
  outline-offset 3px

.reward-tab:focus-visible,
.reward-sub-tab:focus-visible
  outline-offset 0

// ─── Mobile ───────────────────────────────────────────────────────────────────
@media (max-width: 768px)
  .reward-modal
    padding 20px 18px 24px

  .reward-qrcode
    width 160px
    height 160px

@media (max-width: 480px)
  .reward-qrcode
    width 140px
    height 140px

  .reward-sub-tab
    padding 6px 10px

@media (prefers-reduced-motion: reduce)
  #mask,
  .reward-modal,
  .reward-panel,
  .reward-sub-panel
    transition none
